# 本地开发参考（不经过 render；实际使用 backend/.env + feishu-miniprogram/config.js）

name: local
description: 本机开发

public:
  host: localhost
  scheme: http

paths:
  api_context: /clockai/api
  feishu_oauth_callback: /feishu-auth/callback
  frontend_web_base: /clockai
  frontend_feishu_callback: feishu/callback
  frontend_login: ""

frontend:
  dev_port: 5175
  # 完整访问路径（含 Vite base）
  login_url: http://localhost:5175/clockai/login
  site_url: http://localhost:5175/clockai/

backend:
  port: 8080
  api_url: http://localhost:8080/clockai/api

spring:
  profile: dev
