# 复制为 deploy/secrets.env（服务器密钥，勿提交 Git；启动时自动加载）
# 仅需配置密钥与数据库，域名/回调 URL 由 render 从 production.yaml 生成

DB_HOST=
DB_PORT=3306
DB_NAME=attendance_assistant
DB_USER=
DB_PASSWORD=

# --- JWT（prod/uat 必填，至少 32 字节随机串）---
JWT_SECRET=
JWT_EXPIRATION=28800000

# --- 飞书应用 ---
FEISHU_APP_ID=cli_a96dfac04b789cbb
FEISHU_APP_SECRET=

# --- MiMo AI（考勤识图）---
MIMO_API_KEY=
# MIMO_API_KEY_1=
# MIMO_API_KEY_2=
# MIMO_API_KEYS=sk-key1,sk-key2
MIMO_API_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# --- DeepSeek AI（与 MiMo 二选一；系统设置 → 识别模型 切换）---
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_1=
# DEEPSEEK_API_KEY_2=
# DEEPSEEK_API_KEYS=sk-key1,sk-key2
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# --- 可选：多维表格全局默认（各国以 base-config/feishu.md 为准）---
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# --- 可选：对象存储（默认 local，不配则继续用 ./uploads）---
# ATTENDANCE_STORAGE_TYPE=oss
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_KEY_PREFIX=attendance/
# OSS_PUBLIC_BASE_URL=
