{
  "name": "attendance-agent",
  "private": true,
  "description": "AttendanceAgent monorepo tooling",
  "scripts": {
    "render:deploy": "node scripts/render-deploy-config.mjs --env production",
    "render:site": "node scripts/render-deploy-config.mjs --env production",
    "render:deploy:uat": "node scripts/render-deploy-config.mjs --env uat",
    "render:deploy:all": "node scripts/render-deploy-config.mjs --env production && node scripts/render-deploy-config.mjs --env uat",
    "render:deploy:check": "node scripts/render-deploy-config.mjs --env production --check",
    "start:dev": "bash scripts/use-local-dev.sh",
    "restart:dev": "bash scripts/restart-dev-daemon.sh",
    "start:prod": "bash scripts/start-backend-prod.sh",
    "restart:prod": "bash scripts/restart-backend-prod.sh",
    "apply:site": "bash scripts/apply-site-config.sh",
    "build:locales": "node scripts/build-locales.mjs",
    "sync:miniprogram-shared": "node scripts/sync-miniprogram-shared.mjs",
    "check:locale": "cd frontend && npm run check:locale",
    "check:locale:common": "cd frontend && npm run check:locale:common",
    "check:locale:generated": "node scripts/check-locale-generated.mjs",
    "check:miniprogram-shared": "node scripts/check-miniprogram-shared-sync.mjs",
    "sync:miniprogram-shared:check": "npm run sync:miniprogram-shared && npm run check:miniprogram-shared"
  }
}
