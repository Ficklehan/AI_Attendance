.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #5B8FF9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-info {
  flex: 1;
}

.task-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.task-time {
  font-size: 24rpx;
  color: #999999;
}

.image-preview {
  margin-bottom: 24rpx;
}

.preview-header {
  margin-bottom: 16rpx;
}

.preview-image {
  width: 100%;
  border-radius: 12rpx;
}

.stats-card {
  margin-bottom: 24rpx;
}

.stats-header {
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.stat-value.success {
  color: #52c41a;
}

.stat-value.warning {
  color: #faad14;
}

.stat-value.error {
  color: #ff4d4f;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.table-card {
  margin-bottom: 24rpx;
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #5B8FF9;
}

.table-scroll {
  white-space: nowrap;
}

.table-container {
  display: inline-block;
  min-width: 100%;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row.header-row {
  background: #fafafa;
  font-weight: 600;
}

.table-row.deleted {
  opacity: 0.5;
}

.table-row.absent {
  background: #fff2f0;
}

.table-cell {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #333333;
  min-width: 120rpx;
}

.header-row .table-cell {
  color: #666666;
}

.expand-hint {
  padding: 16rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: #999999;
}

.action-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-secondary,
.btn-primary {
  flex: 1;
}

.btn-secondary {
  background: #ffffff;
  border: 2rpx solid #5B8FF9;
  color: #5B8FF9;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}

.btn-primary {
  background: #5B8FF9;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}

.btn-primary.loading {
  opacity: 0.6;
}
