<view class="container">
  <view a:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载识别结果...</text>
  </view>

  <view a:else class="result-content">
    <view class="result-header card">
      <view class="header-info">
        <text class="task-name">{{ taskInfo.name }}</text>
        <text class="task-time">{{ formatTime(taskInfo.createTime) }}</text>
      </view>
      <view class="tag {{getStatusTag(taskInfo.status)}}">
        {{ getStatusText(taskInfo.status) }}
      </view>
    </view>

    <view a:if="{{taskInfo.originalImage}}" class="image-preview card">
      <view class="preview-header">
        <text class="text-base font-medium">原图预览</text>
      </view>
      <image src="{{taskInfo.originalImage}}" mode="widthFix" class="preview-image" />
    </view>

    <view class="stats-card card">
      <view class="stats-header">
        <text class="text-base font-medium">识别统计</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{ stats.total }}</text>
          <text class="stat-label">总记录</text>
        </view>
        <view class="stat-item">
          <text class="stat-value success">{{ stats.normal }}</text>
          <text class="stat-label">正常</text>
        </view>
        <view class="stat-item">
          <text class="stat-value warning">{{ stats.handwritten }}</text>
          <text class="stat-label">手写</text>
        </view>
        <view class="stat-item">
          <text class="stat-value error">{{ stats.absent }}</text>
          <text class="stat-label">未出勤</text>
        </view>
      </view>
    </view>

    <view class="table-card card">
      <view class="table-header">
        <text class="text-base font-medium">识别结果</text>
        <view class="header-actions">
          <text class="action-btn" onTap="toggleExpand">{{ isExpanded ? '收起' : '展开全部' }}</text>
        </view>
      </view>

      <scroll-view scroll-x class="table-scroll">
        <view class="table-container">
          <view class="table-row header-row">
            <view class="table-cell" a:for="{{columns}}" a:key="key">
              {{ item.title }}
            </view>
          </view>
          
          <view 
            a:for="{{displayRecords}}" 
            a:for-item="record"
            a:key="index"
            class="table-row {{record.isDeleted ? 'deleted' : ''}} {{isAbsentRow(record) ? 'absent' : ''}}"
          >
            <view class="table-cell" a:for="{{columns}}" a:key="key">
              <text a:if="{{item.key === 'SmartMark'}}">
                <view class="tag {{getMarkTag(record.SmartMark)}}">
                  {{ record.SmartMark || '-' }}
                </view>
              </text>
              <text a:elif="{{item.key === 'WorkHours'}}">
                {{ record.WorkHours || '-' }}
              </text>
              <text a:else>
                {{ record[item.key] || '-' }}
              </text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view a:if="{{records.length > displayLimit}}" class="expand-hint">
        <text class="hint-text">仅显示前{{ displayLimit }}条，共{{ records.length }}条记录</text>
      </view>
    </view>

    <view class="action-area">
      <view class="btn-secondary" onTap="goBack">
        返回修改
      </view>
      <view class="btn-primary {{isSubmitting ? 'loading' : ''}}" onTap="confirmSubmit">
        <text a:if="{{isSubmitting}}">提交中...</text>
        <text a:else>确认提交</text>
      </view>
    </view>
  </view>
</view>
