<view class="container">
  <view class="filter-bar">
    <view class="filter-tabs">
      <view 
        a:for="{{tabs}}" 
        a:key="value"
        class="filter-tab {{currentTab === item.value ? 'active' : ''}}"
        onTap="switchTab"
        data-value="{{item.value}}"
      >
        {{ item.label }}
        <view a:if="{{item.count}}" class="tab-badge">{{ item.count }}</view>
      </view>
    </view>
    
    <view class="filter-action" onTap="showFilter">
      <text>筛选</text>
      <text class="filter-icon">⚙️</text>
    </view>
  </view>

  <view a:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view a:elif="{{tasks.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无任务</text>
    <text class="empty-desc">快去首页拍照识别考勤表吧</text>
    <view class="btn-primary" onTap="goToHome">
      开始识别
    </view>
  </view>

  <view a:else class="task-list">
    <view 
      a:for="{{tasks}}" 
      a:key="id"
      class="task-card card"
      onTap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="task-header">
        <view class="task-info">
          <text class="task-name ellipsis">{{ item.name }}</text>
          <text class="task-time">{{ formatTime(item.createTime) }}</text>
        </view>
        <view class="tag {{getStatusTag(item.status)}}">
          {{ getStatusText(item.status) }}
        </view>
      </view>
      
      <view a:if="{{item.records && item.records.length > 0}}" class="task-stats">
        <view class="stat-item">
          <text class="stat-num">{{ item.records.length }}</text>
          <text class="stat-text">条记录</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{ getNormalCount(item.records) }}</text>
          <text class="stat-text">正常</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{ getAbsentCount(item.records) }}</text>
          <text class="stat-text">未出勤</text>
        </view>
      </view>

      <view a:if="{{item.originalImage}}" class="task-preview">
        <image src="{{item.originalImage}}" mode="aspectFill" class="preview-image" />
      </view>

      <view class="task-footer">
        <text class="task-country">{{ getCountryName(item.country) }}</text>
        <view class="footer-actions">
          <text class="action-text" catchTap="viewDetail" data-id="{{item.id}}">查看详情</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <view a:if="{{!loading && tasks.length > 0 && hasMore}}" class="load-more">
    <view class="btn-secondary" onTap="loadMore">
      加载更多
    </view>
  </view>
</view>
