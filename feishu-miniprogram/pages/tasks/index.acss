.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.filter-tab {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-tab.active {
  background: #5B8FF9;
  color: #ffffff;
}

.tab-badge {
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.filter-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.filter-action text {
  font-size: 26rpx;
  color: #666666;
}

.filter-icon {
  font-size: 28rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #5B8FF9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  padding: 24rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.task-info {
  flex: 1;
}

.task-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.task-time {
  font-size: 24rpx;
  color: #999999;
}

.task-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #5B8FF9;
}

.stat-text {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
}

.task-preview {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 200rpx;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-country {
  font-size: 24rpx;
  color: #999999;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #5B8FF9;
}

.action-arrow {
  font-size: 28rpx;
  color: #5B8FF9;
}

.load-more {
  padding: 32rpx;
  text-align: center;
}

.btn-primary {
  background: #5B8FF9;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  width: 100%;
  max-width: 400rpx;
}

.btn-secondary {
  background: #ffffff;
  border: 2rpx solid #5B8FF9;
  color: #5B8FF9;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}
