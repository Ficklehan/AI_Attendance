@import "../../styles/design.ttss";

.tasks-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--surface-0);
  box-sizing: border-box;
  padding-bottom: 0;
}

.tasks-filter-wrap {
  flex-shrink: 0;
  padding-top: 8rpx;
  background: var(--surface-0);
}

.tasks-search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 var(--sp-6) var(--sp-4);
}

.tasks-search-input-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 64rpx 0 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.tasks-search-input {
  flex: 1;
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  font-size: 28rpx;
  line-height: 72rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.tasks-search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--text-3);
}

.tasks-search-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.tasks-search-btn:active {
  opacity: 0.88;
}

.tasks-page .segmented {
  margin-bottom: var(--sp-3);
}

.tasks-page .seg-item {
  padding: 12rpx 4rpx;
  font-size: 24rpx;
}

.tasks-tab-hint {
  margin: 0 var(--sp-6) var(--sp-3);
  padding-left: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.45;
}

.tasks-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.task-swipe {
  margin-bottom: var(--sp-4);
}

.tasks-page .task-card-body {
  padding: 26rpx 28rpx;
}

.tasks-page .task-row-list {
  align-items: center;
  gap: 20rpx;
}

.tasks-page .task-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.tasks-page .task-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  width: 100%;
}

.tasks-page .task-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.tasks-page .task-aside {
  flex-shrink: 0;
  max-width: 42%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.tasks-page .task-aside .badge {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  min-height: 40rpx;
}

.tasks-page .task-sync-label {
  font-size: 20rpx;
  color: var(--text-4);
  line-height: 1.3;
  text-align: right;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tasks-page .task-swipe-body {
  transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.tasks-page .task-card:active {
  background: var(--primary-light);
}

.tasks-page .empty {
  background: var(--surface-1);
  border-color: var(--border);
}

.tasks-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  padding: 12rpx var(--sp-6) calc(12rpx + env(safe-area-inset-bottom));
  background: #F8FAFC;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.tasks-bottom-bar .btn-primary {
  min-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.tasks-scroll-pad {
  height: 16rpx;
}

.tasks-has-dock .tasks-scroll-pad {
  height: 112rpx;
}

.tasks-page .tasks-more:active {
  opacity: 0.7;
}

.tasks-page .tasks-loading {
  padding: 80rpx var(--sp-6);
}
