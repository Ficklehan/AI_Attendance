<view class="container">
  <view class="header">
    <view class="logo">📊</view>
    <view class="title">AI考勤助手</view>
    <view class="subtitle">智能识别 · 高效管理</view>
  </view>

  <view class="login-section">
    <view class="login-btn" bindtap="handleFeishuLogin">
      <text class="btn-icon">🔐</text>
      <text class="btn-text">飞书账号登录</text>
    </view>
    
    <view a:if="{{loading}}" class="loading-text">登录中...</view>
    
    <view class="tips">
      <text class="tip-item">✨ 一键登录，安全便捷</text>
      <text class="tip-item">📱 扫码拍照，即刻识别</text>
      <text class="tip-item">📊 同步飞书，高效管理</text>
    </view>
  </view>
</view>