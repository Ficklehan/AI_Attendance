@import "../../styles/design.ttss";

.calibrate-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--surface-1, #f8fafc);
}

.calibrate-page .hint {
  flex-shrink: 0;
  padding: 20rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.55;
}

.calibrate-page .form-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  box-sizing: border-box;
}

.calibrate-page .form-body {
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.calibrate-page .field-row {
  margin-bottom: 32rpx;
}

.calibrate-page .field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  line-height: 1.4;
}

.calibrate-page .field-input-shell {
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.calibrate-page .field-input-shell.is-required-empty {
  border-color: var(--amber, #d97706);
  background: rgba(217, 119, 6, 0.06);
}

.calibrate-page .field-input-shell.is-format-invalid {
  border-color: #d46b08;
  background: rgba(250, 140, 22, 0.1);
}

.calibrate-page .field-input {
  display: block;
  width: 100%;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  font-size: 30rpx;
  line-height: 52rpx;
  color: #111827;
  box-sizing: border-box;
}

.calibrate-page .field-country-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.calibrate-page .field-country-shell.is-required-empty {
  border-color: var(--amber, #d97706);
  background: rgba(217, 119, 6, 0.06);
}

.calibrate-page .field-country-shell.is-locked {
  background: #f8fafc;
}

.calibrate-page .field-country-value {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #111827;
  line-height: 1.4;
}

.calibrate-page .field-country-chevron {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6b7280;
}

.calibrate-page .field-country-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.45;
}

.calibrate-page .field-country-options {
  margin-top: 10rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}

.calibrate-page .field-country-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.calibrate-page .field-country-option:last-child {
  border-bottom: none;
}

.calibrate-page .field-country-option.selected {
  background: rgba(59, 91, 219, 0.08);
}

.calibrate-page .field-country-option-flag {
  font-size: 30rpx;
}

.calibrate-page .field-country-option-name {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.calibrate-page .field-country-option-check {
  color: #3b5bdb;
  font-weight: 700;
}

.calibrate-page .field-format-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #d46b08;
  line-height: 1.45;
}

.calibrate-page .original-line {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-top: 12rpx;
  padding-left: 4rpx;
  line-height: 1.45;
}

.calibrate-page .original-prefix {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9ca3af;
}

.calibrate-page .original-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #dc2626;
  font-weight: 500;
  word-break: break-all;
}

.calibrate-page .reason-block {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.calibrate-page .reason-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.calibrate-page .reason-input-shell {
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.calibrate-page .reason-input {
  display: block;
  width: 100%;
  min-height: 160rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  font-size: 28rpx;
  line-height: 1.55;
  color: #111827;
  box-sizing: border-box;
}

.calibrate-page .history-block {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.calibrate-page .history-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #9a3412;
  line-height: 1.4;
}

.calibrate-page .history-item {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #fdba74;
}

.calibrate-page .history-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.calibrate-page .history-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.calibrate-page .history-who {
  font-weight: 600;
  color: #111827;
}

.calibrate-page .history-at {
  color: #6b7280;
}

.calibrate-page .history-reason {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

.calibrate-page .history-change {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 22rpx;
  line-height: 1.45;
}

.calibrate-page .history-field {
  color: #6b7280;
}

.calibrate-page .history-from {
  color: #dc2626;
  text-decoration: line-through;
}

.calibrate-page .history-arrow {
  color: #9ca3af;
}

.calibrate-page .history-to {
  color: #059669;
  font-weight: 500;
}

.calibrate-page .dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.calibrate-page .btn {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.calibrate-page .btn-secondary {
  background: #f1f5f9;
  color: #374151;
}

.calibrate-page .btn-primary {
  background: #2563eb;
  color: #fff;
}

.calibrate-page .btn.disabled {
  opacity: 0.55;
}
