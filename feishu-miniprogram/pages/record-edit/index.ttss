@import "../record-calibrate/index.ttss";

.exception-type-block {
  margin-bottom: 32rpx;
}

.exception-type-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.exception-type-head-row .field-label {
  margin-bottom: 0;
}

.exception-type-hint-inline {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6b7280;
  white-space: nowrap;
}

.exception-type-stack {
  display: flex;
  gap: 12rpx;
}

.exception-type-stack.is-disabled {
  opacity: 0.45;
}

.exception-type-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  background: #f8fafc;
  text-align: center;
  font-size: 24rpx;
  color: #374151;
}

.exception-type-opt-check {
  font-weight: 800;
}

.exception-type-opt.is-active {
  border-color: transparent;
  color: #fff;
  font-weight: 700;
}

.exception-type-opt.is-active.exception-type-opt--attendance_ok {
  background: #1A9E5C;
}

.exception-type-opt.is-active.exception-type-opt--paper_ok_ocr_wrong {
  background: #C48A0A;
}

.exception-type-opt.is-active.exception-type-opt--paper_wrong_time {
  background: #D94040;
}

.field-input-shell.is-locked {
  opacity: 0.65;
}

.focus-fields-banner {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(220, 38, 38, 0.08);
  border: 1rpx solid rgba(220, 38, 38, 0.28);
}

.focus-fields-banner text {
  display: block;
  font-size: 22rpx;
  color: #b91c1c;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calibrate-page .field-row.is-focus-field {
  padding: 12rpx;
  margin-left: -12rpx;
  margin-right: -12rpx;
  border-radius: 16rpx;
  background: rgba(220, 38, 38, 0.04);
}

.calibrate-page .field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.calibrate-page .field-label-row .field-label {
  margin-bottom: 0;
}

.calibrate-page .field-label.is-focus {
  color: #b91c1c;
  font-weight: 700;
}

.calibrate-page .field-focus-badge {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 20rpx;
  font-weight: 700;
}

.calibrate-page .field-input-shell.is-calib-highlight {
  border-color: #dc2626;
  background: #fff5f5;
  box-shadow: 0 0 0 2rpx rgba(220, 38, 38, 0.18);
}

.calibrate-page .picker-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.calibrate-page .time-hybrid-shell {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.calibrate-page .time-hybrid-input {
  flex: 1;
  min-width: 0;
}

.calibrate-page .time-hybrid-clock {
  flex-shrink: 0;
  min-width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #6b7280;
  border-radius: 10rpx;
  background: #f8fafc;
}

.calibrate-page .field-picker-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.3;
}

.calibrate-page .field-picker-chevron {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #9ca3af;
}

.calibrate-page .shift-picker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.calibrate-page .shift-half {
  flex: 1;
  min-width: 0;
}

.calibrate-page .shift-sep {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 700;
}

.calibrate-page .field-change-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.35;
}

.calibrate-page .restore-hint {
  padding-top: 0;
  color: #1a9e5c;
  font-weight: 600;
}
