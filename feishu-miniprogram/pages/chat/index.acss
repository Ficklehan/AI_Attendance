.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  display: flex;
  gap: 16rpx;
}

.message-item.is-user {
  flex-direction: row-reverse;
}

.message-item.is-user .message-content {
  align-items: flex-end;
}

.message-item.is-user .message-bubble {
  background: #5B8FF9;
  color: #ffffff;
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar text {
  font-size: 36rpx;
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.message-image {
  max-width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.message-image image {
  width: 100%;
  max-width: 400rpx;
}

.message-bubble {
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message-bubble text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
}

.loading-message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding-left: 88rpx;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  background: #999999;
  border-radius: 50%;
  animation: typing-bounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.typing-text {
  font-size: 24rpx;
  color: #999999;
}

.chat-input {
  background: #ffffff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn text {
  font-size: 32rpx;
}

.input-field {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #e8e8e8;
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
}

.send-btn text {
  font-size: 28rpx;
  color: #999999;
}

.send-btn.active {
  background: #5B8FF9;
}

.send-btn.active text {
  color: #ffffff;
}

.image-preview-bar {
  position: fixed;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  background: #ffffff;
  padding: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.preview-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.remove-image {
  font-size: 32rpx;
  color: #999999;
  padding: 8rpx;
}
