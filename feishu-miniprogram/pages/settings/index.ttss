@import "../../styles/design.ttss";

/* ═══ Settings page — configuration polish ═══ */

/* Settings cards — refined surface */
.settings-page .settings-card {
  background: linear-gradient(180deg, var(--surface-1) 0%, rgba(251, 249, 247, 0.95) 100%);
}

/* Settings head — interactive refinement */
.settings-page .settings-head {
  transition: opacity 0.15s ease;
}

.settings-page .settings-head:active {
  opacity: 0.85;
}

/* Selected option — warm highlight */
.settings-page .settings-option.selected {
  background: linear-gradient(135deg, var(--primary-light) 0%, rgba(240, 241, 255, 0.70) 100%);
}

/* Option rows — refined touch */
.settings-page .settings-option {
  transition: background 0.15s ease;
}

.settings-page .settings-option:active {
  background: var(--primary-light);
}

/* Flag icons — subtle refinement */
.settings-page .option-flag {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 240, 255, 0.50);
  border-radius: var(--radius-sm);
}

/* Setup banner — entrance animation */
.settings-page .setup-banner {
  animation: bannerSlideIn 0.4s cubic-bezier(0.23, 1, 0.32, 1) both;
}

@keyframes bannerSlideIn {
  from { opacity: 0; transform: translateY(-12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Check mark — refined accent */
.settings-page .list-check {
  font-size: 34rpx;
}

/* Section labels — refined spacing */
.settings-page .section-label {
  margin-top: var(--sp-2);
}

/* Action text — interactive underline hint */
.settings-page .settings-action {
  position: relative;
}

.settings-page .settings-action:active {
  opacity: 0.7;
}

/* Impact text — subtle treatment */
.settings-page .settings-impact {
  padding: var(--sp-1) 0 0;
  font-style: normal;
}
