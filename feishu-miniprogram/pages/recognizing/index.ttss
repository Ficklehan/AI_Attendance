@import "../../styles/design.ttss";

/* ═══ Recognizing page — centered status composition ═══ */

.rec-page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 0;
}

.rec-main {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  padding: var(--sp-4) 0;
}

.rec-page .rec-hero {
  width: 100%;
  max-width: 640rpx;
  height: 160rpx;
  margin: 0 auto var(--sp-4);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  background: linear-gradient(135deg, #E0E5FF 0%, #F0EDFA 50%, #EDE8FF 100%);
}

.rec-page .rec-hero-mask {
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(248, 250, 252, 0.92) 100%);
}

.rec-page .rec-card {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  padding: var(--sp-6) var(--sp-5) var(--sp-6);
  text-align: center;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 249, 247, 0.94) 100%);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.80);
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
}

.rec-page .rec-steps {
  margin-bottom: var(--sp-5);
  justify-content: center;
}

.rec-page .rec-step-dot {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 22rpx;
}

.rec-page .rec-step-line {
  width: 40rpx;
  margin-bottom: 24rpx;
  transition: background 0.3s ease;
}

.rec-page .rec-step-line.done {
  box-shadow: 0 0 8rpx rgba(52, 199, 123, 0.25);
}

.rec-page .rec-step.active .rec-step-dot {
  box-shadow: var(--shadow-primary), 0 0 16rpx rgba(91, 108, 247, 0.18);
}

.rec-status-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
  text-align: left;
}

.rec-page .rec-ring {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin: 0;
  background: linear-gradient(135deg, var(--primary-light) 0%, rgba(240, 241, 255, 0.80) 100%);
  box-shadow: 0 6rpx 20rpx rgba(91, 108, 247, 0.10);
  animation: ringGlow 3s ease-in-out infinite;
}

.rec-page .rec-spinner {
  width: 40rpx;
  height: 40rpx;
}

@keyframes ringGlow {
  0%, 100% { box-shadow: 0 6rpx 20rpx rgba(91, 108, 247, 0.10); }
  50% { box-shadow: 0 6rpx 28rpx rgba(91, 108, 247, 0.20); }
}

.rec-status-main {
  flex: 1;
  min-width: 0;
  max-width: 420rpx;
}

.rec-page .rec-title {
  font-size: var(--font-md);
  font-weight: 700;
  text-align: left;
  line-height: 1.35;
}

.rec-page .rec-context {
  margin: var(--sp-1) 0 0;
  box-shadow: var(--shadow-xs);
}

.rec-page .rec-tags {
  justify-content: flex-start;
  margin-top: var(--sp-2);
}

.rec-page .rec-tag {
  transition: opacity 0.2s ease;
}

.rec-row-count {
  display: block;
  margin-top: var(--sp-3);
  font-size: 30rpx;
  font-weight: 800;
  color: var(--primary);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.rec-page .rec-hint {
  margin-top: var(--sp-3);
  text-align: center;
  font-size: var(--font-xs);
  line-height: 1.45;
}

.rec-page .rec-bg-hint {
  margin-top: var(--sp-2);
  text-align: center;
  opacity: 0.9;
}

.rec-page .rec-dock {
  z-index: 210;
}
