.preview-page {
  min-height: 100vh;
  background: #1c1a2e;
  display: flex;
  flex-direction: column;
}

.preview-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
  gap: 16rpx;
  flex-shrink: 0;
}

.preview-tool-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.preview-tool-btn.primary {
  background: rgba(91, 108, 247, 0.85);
}

.preview-tool-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.preview-toolbar-center {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.preview-file-name {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-counter {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.preview-switch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
  gap: 16rpx;
  flex-shrink: 0;
}

.preview-switch-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(91, 108, 247, 0.35);
}

.preview-switch-icon {
  font-size: 34rpx;
  line-height: 1;
  color: #fff;
  font-weight: 300;
}

.preview-switch-label {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.preview-switch-counter {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  font-weight: 700;
}

.preview-zoom-bar {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 16rpx;
  padding: 0 24rpx 12rpx;
  flex-shrink: 0;
}

.preview-zoom-btn {
  flex: 1;
  max-width: 220rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.preview-zoom-reset {
  max-width: 260rpx;
}

.preview-zoom-icon {
  font-size: 36rpx;
  line-height: 1;
  color: #fff;
  font-weight: 300;
}

.preview-zoom-percent {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

.preview-zoom-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
}

.preview-main {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.preview-swiper {
  width: 100%;
  height: 62vh;
}

.preview-slide {
  width: 100%;
  height: 62vh;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
}

.preview-rotate {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-rotate-90 {
  transform: rotate(90deg);
}

.preview-rotate-180 {
  transform: rotate(180deg);
}

.preview-rotate-270 {
  transform: rotate(270deg);
}

.preview-image {
  width: 710rpx;
  max-width: 100%;
  height: 58vh;
  display: block;
}

.preview-image-transform {
  transform-origin: center center;
}

.preview-gesture-hint {
  flex-shrink: 0;
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
}

.preview-error {
  height: 62vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.preview-error text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}
