@import "../../styles/design.ttss";

.camera-viewport--framed {
  margin: 12rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: inset 0 0 0 2rpx rgba(107, 128, 255, 0.55);
}

.camera-init-hint-inline {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #93c5fd;
  line-height: 1.35;
}

.camera-page .capture-inner {
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.camera-page .capture-btn:active .capture-inner {
  transform: scale(0.9);
}

.camera-page .capture-ring {
  animation: ringBreathe 3s ease-in-out infinite;
}

@keyframes ringBreathe {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.75; }
}
