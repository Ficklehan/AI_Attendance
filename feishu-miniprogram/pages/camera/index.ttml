<view class="camera-page">
  <view class="camera-header">
    <view class="camera-nav-btn" bindtap="goBack">‹</view>
    <view class="camera-header-main">
      <text class="camera-title">{{texts.title}}</text>
      <text class="camera-hint-inline">{{texts.scanHint}}</text>
      <text tt:if="{{initHint}}" class="camera-init-hint-inline" bindtap="onInitHintTap">{{initHint}}</text>
    </view>
    <view class="camera-nav-btn" bindtap="toggleFlash">
      <text class="flash-icon" style="opacity:{{flashMode === 'torch' ? '1' : '0.45'}}">⚡</text>
    </view>
  </view>

  <view class="camera-viewport camera-viewport--framed">
    <camera
      id="camera"
      class="camera-core"
      device-position="back"
      flash="{{flashMode}}"
      resolution="medium"
      bindinserted="onCameraInserted"
      bindinitdone="onCameraInitDone"
      bindstop="onCameraStop"
      binderror="onCameraError"
    ></camera>
  </view>

  <view class="camera-bottom">
    <view class="camera-controls">
      <view class="control-btn" bindtap="chooseFromGallery">
        <text>{{texts.gallery}}</text>
      </view>
      <view class="capture-btn" catchtap="takePhoto">
        <view class="capture-ring"></view>
        <view class="capture-inner"></view>
      </view>
      <view class="control-btn control-btn-muted" bindtap="chooseFromCamera">
        <text>{{texts.systemCamera}}</text>
      </view>
    </view>
    <view class="camera-tips-row">
      <text class="camera-tip-chip">{{texts.tipLight}}</text>
      <text class="camera-tip-chip">{{texts.tipFlat}}</text>
      <text class="camera-tip-chip">{{texts.tipAngle}}</text>
    </view>
  </view>
</view>
