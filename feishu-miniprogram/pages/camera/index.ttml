<view class="camera-page">
  <view class="camera-header">
    <view class="camera-nav-btn" bindtap="goBack">‹</view>
    <view class="camera-header-main">
      <text class="camera-title">{{texts.title}}</text>
      <text class="camera-subtitle">{{texts.scanGuide}}</text>
    </view>
    <view class="camera-nav-btn" bindtap="toggleFlash">
      <text style="font-size:28rpx;opacity:{{flashMode === 'on' ? '1' : '0.4'}}">⚡</text>
    </view>
  </view>

  <view class="camera-viewport">
    <camera
      id="camera"
      class="camera-core"
      device-position="{{cameraPosition}}"
      flash="{{flashMode}}"
      bindinitdone="onCameraInitDone"
      bindstop="onCameraStop"
      binderror="onCameraError"
    ></camera>

    <view class="scan-frame">
      <view class="frame-corner tl"></view>
      <view class="frame-corner tr"></view>
      <view class="frame-corner bl"></view>
      <view class="frame-corner br"></view>
      <view class="scan-line"></view>
    </view>

    <view class="camera-hint">
      <text class="camera-hint-title">{{texts.scanHint}}</text>
      <text class="camera-hint-sub">{{texts.guideTitle}}</text>
    </view>

    <view tt:if="{{initHint}}" class="camera-init-hint" bindtap="onInitHintTap">
      <text>{{initHint}}</text>
    </view>
  </view>

  <view class="camera-bottom">
    <view class="camera-guides">
      <view class="guide-pill">
        <view class="guide-dot"></view>
        <text>{{texts.tipLight}}</text>
      </view>
      <view class="guide-pill">
        <view class="guide-dot"></view>
        <text>{{texts.tipFlat}}</text>
      </view>
      <view class="guide-pill">
        <view class="guide-dot"></view>
        <text>{{texts.tipAngle}}</text>
      </view>
    </view>

    <view class="camera-controls">
      <view class="control-btn" bindtap="toggleCamera">
        <text>{{texts.flip}}</text>
      </view>
      <view class="capture-btn" bindtap="takePhoto">
        <view class="capture-ring"></view>
        <view class="capture-inner"></view>
      </view>
      <view class="control-btn" bindtap="chooseFromGallery">
        <text>{{texts.gallery}}</text>
      </view>
    </view>
  </view>
</view>
