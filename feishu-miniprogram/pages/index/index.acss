.container {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.header {
  padding: 40rpx 0;
  text-align: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999999;
}

.upload-area {
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.upload-icon text {
  font-size: 60rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.image-list {
  margin-bottom: 24rpx;
}

.image-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.image-scroll {
  white-space: nowrap;
}

.image-items {
  display: inline-flex;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.country-selector {
  margin-bottom: 24rpx;
}

.selector-header {
  margin-bottom: 16rpx;
}

.country-scroll {
  white-space: nowrap;
}

.country-items {
  display: inline-flex;
  gap: 16rpx;
}

.country-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.country-item.active {
  background: #5B8FF9;
  color: #ffffff;
}

.action-area {
  margin-bottom: 24rpx;
}

.btn-primary {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #7B68EE 100%);
  color: #ffffff;
  text-align: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-primary.loading {
  opacity: 0.6;
}

.quick-tasks {
  margin-bottom: 24rpx;
}

.quick-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-info {
  flex: 1;
}

.task-name {
  font-size: 28rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.task-time {
  font-size: 24rpx;
  color: #999999;
}

.empty-tips {
  text-align: center;
  padding: 40rpx;
}

.text-base {
  font-size: 28rpx;
}

.font-medium {
  font-weight: 500;
}

.text-sm {
  font-size: 24rpx;
}

.text-muted {
  color: #999999;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tag-default {
  background: #f0f0f0;
  color: #666666;
}

.tag-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-success {
  background: #f6ffed;
  color: #52c41a;
}

.tag-primary {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-error {
  background: #fff2f0;
  color: #ff4d4f;
}
