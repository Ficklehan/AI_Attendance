# 复制为 .env 后填写（与 PC 端共用同一后端配置）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_assistant
DB_USER=root
DB_PASSWORD=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 必填：MiMo 真实 AI 识别（未配置时识别接口会报错，不再静默使用模拟数据）
MIMO_API_KEY=sk-your-xiaomi-mimo-api-key
MIMO_API_URL=https://api.xiaomimimo.com/v1
# 考勤识图：mimo-v2.5（多模态）；mimo-v2.5-pro 仅文本，会 404 image input
MIMO_MODEL=mimo-v2.5

# 飞书 OAuth 回调（须与 server.port、context-path 一致）
# FEISHU_REDIRECT_URI=http://localhost:8080/attendance/api/feishu-auth/callback

# 仅本地调试、且无 API Key 时才设为 true（会生成假数据，不使用 PC 提示词）
# ALLOW_SIMULATED_RECOGNITION=true
