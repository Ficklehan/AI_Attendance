# 复制为 backend/.env 后填写（本地开发）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_assistant
DB_USER=root
DB_PASSWORD=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 本地飞书 OAuth（与 application.yml 默认一致）
FEISHU_REDIRECT_URI=http://localhost:8080/clockai/api/feishu-auth/callback
FEISHU_FRONTEND_CALLBACK_URL=http://localhost:5175/clockai/feishu/callback
FEISHU_FRONTEND_LOGIN_URL=http://localhost:5175/clockai/

# 多 Key 池（推荐，每行一个，用于多图并行；某 Key 失效时自动切换其他 Key）
# MIMO_API_KEY_1=sk-your-key-1
# MIMO_API_KEY_2=sk-your-key-2
# 或逗号合并为一行：MIMO_API_KEYS=sk-key1,sk-key2
MIMO_API_KEY=sk-your-xiaomi-mimo-api-key
MIMO_API_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# DeepSeek 识图（与 MiMo 二选一；在「系统设置 → 识别模型」中切换，仅管理员）
# 单 Key：
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 多 Key 池（任选一种写法）：
# DEEPSEEK_API_KEY_1=sk-your-deepseek-key-1
# DEEPSEEK_API_KEY_2=sk-your-deepseek-key-2
# DEEPSEEK_API_KEYS=sk-key1,sk-key2
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# 识图须用 vision 模型（deepseek-v4-flash-vision-exp）；勿填 deepseek-chat / DeepSeek-OCR-2
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_TEMPERATURE=0.3
# DEEPSEEK_MAX_TOKENS=8192
# DEEPSEEK_TOP_P=0.9

# --- 公网部署（prod/uat）---
# 域名与回调 URL 不再在此维护，请改 deploy/environments/production.yaml 后运行：
#   node scripts/render-deploy-config.mjs --env production
# 服务器合并 deploy/rendered/production.env + deploy/secrets.example 中的密钥
# 详见 deploy/README.md

# 仅本地调试、且无 API Key 时才设为 true
# ALLOW_SIMULATED_RECOGNITION=true

# --- 生产多实例 / 几百人并发（需 Redis）---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# RECOGNITION_GLOBAL_MAX=8
# RECOGNITION_MAX_PER_USER=2
# RECOGNITION_MIMO_QPS=5
# RECOGNITION_ZOMBIE_MINUTES=36
# RECOGNITION_DISTRIBUTED_ENABLED=true
