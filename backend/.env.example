# 复制为 backend/.env 后填写（本地开发）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_assistant
DB_USER=root
DB_PASSWORD=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 本地飞书 OAuth（与 application.yml 默认一致）
FEISHU_REDIRECT_URI=http://localhost:8080/attendance/api/feishu-auth/callback
FEISHU_FRONTEND_CALLBACK_URL=http://localhost:5175/attendance/feishu/callback
FEISHU_FRONTEND_LOGIN_URL=http://localhost:5175/attendance/

# 必填：MiMo 真实 AI 识别
MIMO_API_KEY=sk-your-xiaomi-mimo-api-key
MIMO_API_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# --- 公网部署（prod/uat）---
# 域名与回调 URL 不再在此维护，请改 deploy/environments/production.yaml 后运行：
#   node scripts/render-deploy-config.mjs --env production
# 服务器合并 deploy/rendered/production.env + deploy/secrets.example 中的密钥
# 详见 deploy/README.md

# 仅本地调试、且无 API Key 时才设为 true
# ALLOW_SIMULATED_RECOGNITION=true
